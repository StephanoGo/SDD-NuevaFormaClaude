# Normaliza los finales de línea de todo el repositorio.
# Fija LF (evita los avisos "LF will be replaced by CRLF" en Windows).
* text=auto eol=lf

# Archivos que se comparan como texto (diferencias legibles)
*.cs        text eol=lf
*.csproj    text eol=lf
*.sln       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.js        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf

# Binarios: nunca convertir
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.dll       binary
*.exe       binary
