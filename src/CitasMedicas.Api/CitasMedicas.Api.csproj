<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\CitasMedicas.Application\CitasMedicas.Application.csproj" />
    <ProjectReference Include="..\CitasMedicas.Infrastructure\CitasMedicas.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\CitasMedicas.Web\wwwroot\**\*">
      <TargetPath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
